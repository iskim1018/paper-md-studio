{
  "identifier": "default",
  "description": "기본 앱 권한",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/paper-md-studio-cli",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "fs:allow-read-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:default",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "dialog:allow-message",
    {
      "identifier": "fs:scope",
      "allow": [
        "**"
      ]
    },
    "updater:default",
    "process:allow-restart",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**"
        }
      ]
    }
  ]
}
