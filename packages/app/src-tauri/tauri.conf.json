{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Paper MD Studio",
  "version": "0.5.2",
  "identifier": "com.paper-md-studio.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Paper MD Studio",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Productivity",
    "copyright": "Copyright (c) 2026 Insung Kim",
    "shortDescription": "HWP/HWPX/DOCX/PDF를 Markdown으로 변환·편집",
    "longDescription": "Paper MD Studio는 HWP, HWPX, DOCX, PDF 문서를 Markdown으로 변환하고 그 자리에서 WYSIWYG/소스/분할 모드로 편집할 수 있는 크로스플랫폼 데스크톱 앱입니다. 표 셀 내부 이미지 추출, 스타일(볼드/이탈릭/취소선) 보존, 배치 변환, 다크모드 등을 지원합니다.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/paper-md-studio-cli"
    ],
    "resources": {
      "resources/node": "resources/node",
      "resources/cli": "resources/cli",
      "resources/hwp-to-hwpx.jar": "resources/hwp-to-hwpx.jar",
      "resources/jre.tar.gz": "resources/jre.tar.gz"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEQUY3QjQ3RDlGNDBDMjgKUldRb0RQVFpSM3V2alF6dUd1L1U1MEpXc2R0ZFhwc0V6ZWdJNDN4MUJ2aFZDS1p0Z2l5UkNjNkgK",
      "endpoints": [
        "https://github.com/iskim1018/paper-md-studio/releases/latest/download/latest.json"
      ]
    }
  }
}
