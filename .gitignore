test-results/

# Test fixture samples — 이 폴더에는 "공개 가능한" 샘플만 둔다.
# 비공개 업무 문서는 아래 /private/ 안에서만 다룰 것 (폴더 전체 무시).
# 개발자는 로컬에 sample.{hwp,hwpx,docx,pdf}·sample-with-image.docx 를 배치하며,
# 없으면 관련 테스트는 자동 skip 된다. 자세한 원칙은 해당 폴더의 README 참고.
packages/core/tests/fixtures/*.hwp
packages/core/tests/fixtures/*.hwpx
packages/core/tests/fixtures/*.docx
packages/core/tests/fixtures/*.pdf
packages/core/tests/fixtures/*.md
packages/core/tests/fixtures/*_images/
!packages/core/tests/fixtures/README.md

# 루트에서 변환 테스트 시 생기는 임시 산출물 (커밋 금지)
# 루트 *.md는 README/CHANGELOG와 충돌하므로 *.md 패턴은 넣지 않음
/*.hwp
/*.hwpx
/*.docx
/*.pdf
/*_images/
# 변환 산출 .md는 케이스별로 명시 (루트 *.md를 한꺼번에 막을 수 없어서)
/nested_tables.md

# ─────────────────────────────────────────────────────────────
# 개인 장비 전용 작업 공간.
#
# 공개하면 안 되는 실문서와 그 파생물(변환 결과·중간 산출물)은 전부 이 폴더
# 안에서만 다룬다. 확장자별로 거르지 않고 폴더를 통째로 무시하므로, 안에
# 무엇을 만들든 새어나가지 않고 파일명·확장자도 규칙에서 드러나지 않는다.
# 저장소에 올릴 샘플은 합성 문서만 쓴다 (scripts/make-pdf-corpus.mjs).
# ─────────────────────────────────────────────────────────────
/private/

# 합성 코퍼스·비교 산출물 (scripts/ 로 언제든 재생성)
/pdf-corpus/
/pdf-ab-out/

# TypeScript build info
*.tsbuildinfo

# Claude Code — 공유: settings.json, rules/, skills/{convert-test,doc-update,security-check}/
# 제외: 개인 데이터 · 로컬 초안 · 이전 실험 잔재
.claude/memory/
.claude/plan/
.claude/settings.local.json

# git history 재작성 전 백업 (로컬 전용)
.git.backup/

# Logs
*.log
npm-debug.log*
